{
  "compilerOptions": {
    // JS latest conversion standard
    "target": "ES2020",
    // Defining of class fields to behave as JS standard
    "useDefineForClassFields": true,
    // Usable inner API type definition
    "lib": [
      "ES2020", // Latest JS API
      "DOM", // document, window browser API
      "DOM.Iterable" // NodeList iterable use
    ],
    // Latest version of ES Module(import/export)
    "module": "ESNext",
    // node_modules skips type check
    "skipLibCheck": true,
    // Vite/Webpack style module resolute
    "moduleResolution": "node",
    // .ts/.tsx extender import allowance
    "allowImportingTsExtensions": true,
    // json import allowance
    "resolveJsonModule": true,
    // Force File Unit Independent Compile (Vite/esbuild Compatibility)
    "isolatedModules": true,
    // JS No Emit (Vite takes charge)
    "noEmit": true,
    // React 17+ JSX Use Conversion Method
    "jsx": "react-jsx",
    // String Type Check
    "strict": true,
    // Cause Errors for Unused Local Variables
    "noUnusedLocals": true,
    // Cause Errors for Unused Parameters
    "noUnusedParameters": true,
    // Prevent missing 'Break' in switch statement for potential mistakes
    "noFallthroughCasesInSwitch": true
  },
  // TypeScript Validation Specified Folder
  "include": [
    "src",
    "src/vite-env.d.ts"
  ]
}
