# Development Environment
ENV=dev|prod
NODE_ENV=docker|production

# DB configuration
DB_TYPE=yourDatabase
DB_HOST=yourDatabase
DB_PORT=yourPort
DB_USERNAME=yourDBport
DB_PASSWORD=yourDBpassword
DB_DATABASE=yourDBtype

# Hash 
HASH_ROUNDS=hashRounds

# Secret Token
REFRESH_TOKEN_SECRET=yourEncodedSecretKey
ACCESS_TOKEN_SECRET=yourEncodedSecretKey

# Expiry
REFRESH_TOKEN_SECRET_EXPIRES_IN=expiryTime
ACCESS_TOKEN_SECRET_EXPIRES_IN=expiryTime

# Redis Configuration
REDIS_URL=redis://user:password@host:port

# Redis TTL (seconds)
USER_CACHE_TTL_SEC=ttlSec
SESSION_TTL_SEC=ttlSec
MESSAGE_CACHE_TTL_SEC=ttlSec

# Admin
MAX_ADMIN_COUNT=your-count

# CORS (comma-separated list — main frontend + admin dashboard run on different origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Google Gemini AI
GEMINI_API_KEY=your-gemini-key

# Mail (SMTP) - optional; role-change emails are skipped if unset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
MAIL_FROM=your-from-address

# Logging (Railway persistent volume) - Railway auto-injects RAILWAY_VOLUME_MOUNT_PATH once a
# volume is attached to the backend service; do not set it yourself. Local dev/CI fall back to
# ./logs automatically when it's unset. Provision the volume manually (one-time, not via config
# file -- Railway has no config-as-code support for volumes): railway volume add --mount-path /data
# See ADR 0018 (ADR/0018-railway-volume-log-persistence.md).
#
# (한글) Railway 영구 볼륨 - 볼륨이 backend 서비스에 연결되면 Railway가 RAILWAY_VOLUME_MOUNT_PATH를
# 자동으로 주입합니다. 직접 설정하지 마세요. 로컬 개발/CI는 값이 없으면 자동으로 ./logs로
# 폴백합니다. 볼륨은 설정 파일이 아니라 수동으로 1회 생성해야 합니다(Railway는 볼륨에 대한
# config-as-code를 지원하지 않음): railway volume add --mount-path /data
# 자세한 내용은 ADR 0018(ADR/0018-railway-volume-log-persistence.ko.md) 참고.
# RAILWAY_VOLUME_MOUNT_PATH=/data

# Error tracking (Sentry, backend only) - optional; captureException becomes a safe no-op when
# unset (no Sentry.init() runs), so local dev/CI never needs an account. Only 5xx errors are
# reported (4xx is normal traffic, not sent). See ADR 0019 (ADR/0019-sentry-error-tracking.md).
#
# (한글) 에러 트래킹(Sentry, backend 전용) - 선택 사항이며, 값이 없으면 Sentry.init()이 아예
# 실행되지 않아 captureException이 안전하게 no-op됩니다. 로컬 개발/CI는 계정이 필요 없습니다.
# 5xx만 전송되고 4xx(정상 트래픽)는 보내지 않습니다.
# 자세한 내용은 ADR 0019(ADR/0019-sentry-error-tracking.ko.md) 참고.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Moderation (behavioral abuse detection) - all optional; ModerationService falls back to
# the defaults shown if unset. Strikes accrue in STRIKE_WINDOW, then escalate by count:
# WARN -> system-message warning, MUTE -> temporary mute, BAN -> timed ban, repeat -> permanent.
# DUP = this many identical messages within DUP_WINDOW add one strike.
# Durations are seconds (86400=24h, 600=10m, 604800=7d, 60=1m).
MODERATION_STRIKE_WINDOW_SEC=86400
MODERATION_WARN_THRESHOLD=3
MODERATION_MUTE_THRESHOLD=5
MODERATION_MUTE_DURATION_SEC=600
MODERATION_BAN_THRESHOLD=7
MODERATION_BAN_DURATION_SEC=604800
MODERATION_DUP_WINDOW_SEC=60
MODERATION_DUP_THRESHOLD=3
