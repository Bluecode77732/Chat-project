# 개발 환경
ENV=dev|prod
NODE_ENV=development|test|production

# 런타임 환경 — docker-compose.yml만 `docker`로 설정함(envFilePath 선택과 main.ts 호스트
# 바인딩에서 "로컬 docker-compose 스택 안에서 실행 중"임을 식별하는 용도). 그냥
# `pnpm start:dev`/`start:prod`나 Railway에서는 비워둠(기본값이 native 동작).
RUNTIME_ENV=native|docker

# DB 설정
DB_TYPE=yourDatabase
DB_HOST=yourDatabase
DB_PORT=yourPort
DB_USERNAME=yourDBport
DB_PASSWORD=yourDBpassword
DB_DATABASE=yourDBtype

# 해시
HASH_ROUNDS=hashRounds

# 시크릿 토큰
REFRESH_TOKEN_SECRET=yourEncodedSecretKey
ACCESS_TOKEN_SECRET=yourEncodedSecretKey

# 만료 시간
REFRESH_TOKEN_SECRET_EXPIRES_IN=expiryTime
ACCESS_TOKEN_SECRET_EXPIRES_IN=expiryTime

# Redis 설정
REDIS_URL=redis://user:password@host:port

# Redis TTL(초)
USER_CACHE_TTL_SEC=ttlSec
SESSION_TTL_SEC=ttlSec
MESSAGE_CACHE_TTL_SEC=ttlSec

# 관리자
MAX_ADMIN_COUNT=your-count

# CORS(콤마로 구분된 목록 — 메인 프론트엔드와 admin 대시보드가 서로 다른 origin에서 실행됨)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Google Gemini AI
GEMINI_API_KEY=your-gemini-key

# 메일(SMTP) — 선택값; 비어있으면 역할 변경 이메일을 건너뜀
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-app-password
MAIL_FROM=your-from-address

# 로깅(Railway 영구 볼륨) — 볼륨이 backend 서비스에 연결되면 Railway가 시작 시
# RAILWAY_VOLUME_MOUNT_PATH를 자동으로 주입함, 직접 설정하지 않음. 로컬 개발/CI는 값이
# 없으면 자동으로 ./logs로 폴백함. 볼륨은 설정 파일이 아니라 수동으로 1회 생성해야 함
# (Railway는 볼륨에 대한 config-as-code를 지원하지 않음): railway volume add --mount-path /data
# 자세한 내용은 ADR 0018(ADR/0018-railway-volume-log-persistence.ko.md) 참고.
# RAILWAY_VOLUME_MOUNT_PATH=/data

# 에러 트래킹(Sentry, backend 전용) — 선택값; 비어있으면 Sentry.init()이 아예 실행되지
# 않아 captureException이 안전하게 no-op됨(로컬 개발/CI는 계정 불필요). 5xx만 전송되고
# 4xx(정상 트래픽)는 보내지 않음. 자세한 내용은 ADR 0019(ADR/0019-sentry-error-tracking.ko.md) 참고.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# 인증 레이트리밋(인증 전 클라이언트 IP당 로그인/가입 시도) — 둘 다 선택값; 비어있으면
# AuthRateLimitGuard가 아래 기본값으로 대체함. CI e2e는 MAX_ATTEMPTS를 올리는데, 순차
# 실행되는 스펙들이 한 IP에서 윈도우 안에 10회 넘게 register/signin을 하기 때문
# (deploy.yml의 e2e job env 참고).
AUTH_RATE_LIMIT_WINDOW_SEC=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# 모더레이션(행동 기반 어뷰징 탐지) — 전부 선택값; 비어있으면 ModerationService가 아래
# 기본값으로 대체함. 스트라이크는 STRIKE_WINDOW 안에서 쌓이고, 횟수에 따라 에스컬레이션됨:
# WARN -> 시스템 메시지 경고, MUTE -> 임시 뮤트, BAN -> 기간제 밴, 반복 -> 영구 밴.
# DUP = DUP_WINDOW 안에 동일 메시지가 이 횟수만큼 오면 스트라이크 1회 추가.
# 기간 단위는 초(86400=24시간, 600=10분, 604800=7일, 60=1분).
MODERATION_STRIKE_WINDOW_SEC=86400
MODERATION_WARN_THRESHOLD=3
MODERATION_MUTE_THRESHOLD=5
MODERATION_MUTE_DURATION_SEC=600
MODERATION_BAN_THRESHOLD=7
MODERATION_BAN_DURATION_SEC=604800
MODERATION_DUP_WINDOW_SEC=60
MODERATION_DUP_THRESHOLD=3
